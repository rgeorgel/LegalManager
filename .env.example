# ==============================================================================
# Causify — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar.
# NUNCA commite o arquivo .env no repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=legalmanager
POSTGRES_PORT=6632            # porta exposta no host (interna sempre 5432)

# ------------------------------------------------------------------------------
# API — ASP.NET Core
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production   # Development | Staging | Production
API_PORT=6600                        # porta exposta no host (interna 8080)

# Banco externo (ex.: um branch do Neon, host direto, sem "-pooler"): preencha DB_CONNECTION_STRING.
# Vale para o docker-compose (as POSTGRES_* deixam de ser obrigatórias; suba com
# `docker compose up -d --no-deps api` para não iniciar o container postgres) e para `dotnet run`
# (Development), que lê este arquivo. Sem ela, a string é montada a partir das POSTGRES_* acima.
# Formato Npgsql (chave=valor), não URL postgresql://. Senha com '#' ou espaço: valor entre aspas.
# O `dotnet run` também aceita aqui qualquer chave no formato Secao__Chave (ex.: Escavador__UseMock=true).
# ex.: DB_CONNECTION_STRING=Host=ep-xxx.us-east-1.aws.neon.tech;Database=legalmanager;Username=neondb_owner;Password=troque_esta_senha;SSL Mode=Require
DB_CONNECTION_STRING=

# Neon — variáveis gravadas pelas ferramentas do Neon (CLI/integração) ao criar ou ligar um branch.
# A API NÃO as lê (nem o docker-compose, nem o `dotnet run`): para usar o banco, copie os dados
# da DATABASE_URL_UNPOOLED (host direto) para a DB_CONNECTION_STRING acima, no formato Npgsql.
# ex.: DATABASE_URL=postgresql://neondb_owner:troque_esta_senha@ep-xxx-pooler.us-east-1.aws.neon.tech/legalmanager?sslmode=require
DATABASE_URL=
# ex.: DATABASE_URL_UNPOOLED=postgresql://neondb_owner:troque_esta_senha@ep-xxx.us-east-1.aws.neon.tech/legalmanager?sslmode=require
DATABASE_URL_UNPOOLED=
# ex.: NEON_BRANCH=dev
NEON_BRANCH=

# ------------------------------------------------------------------------------
# JWT — Autenticação
# Gere uma chave forte: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_KEY=TROQUE_ESTA_CHAVE_SECRETA_COM_NO_MINIMO_32_CARACTERES
JWT_ISSUER=Causify
JWT_AUDIENCE=CausifyUsers
# Duração dos tokens (opcional — padrão: 60min access, 7d refresh)
# JWT_ACCESS_TOKEN_MINUTES=60
# JWT_REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# Frontend / CORS
# URL pública do frontend (usada em links de e-mail e CORS)
# ------------------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:6600

# ------------------------------------------------------------------------------
# Google — Login com a conta do Google
# Console: https://console.cloud.google.com/apis/credentials
# Crie um "OAuth Client ID" do tipo "Web application", com as origens
# autorizadas (localhost em dev + o(s) domínio(s) de produção). Não é preciso
# Client Secret — o login usa Google Identity Services (ID token), validado
# aqui no backend só pelo Client ID (audience).
#
# O mesmo valor também precisa ser colado manualmente no atributo
# data-client_id do botão do Google em src/LegalManager.API/wwwroot/login.html
# — essa página é servida como HTML estático, sem templating do backend, então
# essa variável de ambiente não alcança o frontend sozinha.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Resend — E-mail transacional (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_TOKEN=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@seudominio.com.br
RESEND_FROM_NAME=Causify

# ------------------------------------------------------------------------------
# Seq — Log estruturado (https://datalust.co/seq)
# ------------------------------------------------------------------------------
SEQ_PORT_API=6641    # porta da API de ingestão (interna 5341)
SEQ_PORT_UI=6681     # porta da UI web      (interna 80)
# SEQ_API_KEY=        # opcional — chave de API para autenticação no Seq

# ------------------------------------------------------------------------------
# Pydantic Logfire — Logs estruturados via OTLP (https://logfire.pydantic.dev)
# Sink adicional ao Seq/Console — não substitui nem remove os existentes.
# Token: logfire.pydantic.dev → projeto → "Project settings" → "Tokens"
# Endpoint padrão é US (logfire-us.pydantic.dev). Para projetos EU use:
#   https://logfire-eu.pydantic.dev/v1/logs
# ------------------------------------------------------------------------------
LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=
LOGFIRE_ENDPOINT=https://logfire-us.pydantic.dev/v1/logs
LOGFIRE_SERVICE_NAME=causify-api
LOGFIRE_SERVICE_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Adsterra — Publicidade (https://beta.publishers.adsterra.com)
# Só escritórios no plano Free veem anúncios; planos pagos nunca. Locais: 2 blocos no
# dashboard (um sempre na 2ª posição), 1 a cada 3 tarefas e 1 a cada 4 processos.
# ADSTERRA_ENABLED=false desliga tudo (nenhum anúncio é servido nem carregado).
# Cada valor vem do "GET CODE" da unidade no painel do Adsterra:
#   Banners: a 'key' do atOptions (e o domínio do invoke.js em ADSTERRA_BANNER_HOST).
#   Native Banner: o src do <script> (ex.: //plNNNNNNNN.dominio.com/<hash>/invoke.js).
# Formato sem valor não é usado; a página escolhe entre os configurados pelo espaço livre.
#
# ADSTERRA_FRAME_ORIGIN: host próprio dos anúncios, apontando para esta mesma API (ex.: um
# CNAME "ads" no Cloudflare). Necessário: sem ele o iframe tem origem "null" e a checagem
# antifraude do Adsterra falha no CORS. Nesse host a API só serve a página do anúncio, e o
# proxy precisa repassar o Host original. Em dev (dotnet run): ADSTERRA_FRAME_ORIGIN=http://127.0.0.1:5123
# e App__FrontendUrl=http://localhost:5123, com o app aberto em http://localhost:5123.
# ------------------------------------------------------------------------------
ADSTERRA_ENABLED=false
# ex.: ADSTERRA_FRAME_ORIGIN=https://ads.causify.com.br
ADSTERRA_FRAME_ORIGIN=
# ex.: ADSTERRA_BANNER_HOST=www.highperformanceformat.com
ADSTERRA_BANNER_HOST=
ADSTERRA_BANNER_300X250=
ADSTERRA_BANNER_728X90=
ADSTERRA_BANNER_468X60=
ADSTERRA_BANNER_320X50=
ADSTERRA_NATIVE_SCRIPT=

# ------------------------------------------------------------------------------
# Hangfire — Dashboard (/hangfire)
# Obrigatório em produção — protege o dashboard com Basic Auth dedicado.
# Gere uma senha forte: openssl rand -base64 24
# ------------------------------------------------------------------------------
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASSWORD=troque_esta_senha
# true = esta instância não executa jobs nem registra/remove os recorrentes (o painel continua).
# Use ao apontar a API local para um banco compartilhado (ex.: produção no Neon) — senão ela
# disputa os jobs com o servidor de produção e sobrescreve a agenda dos recorrentes.
# Vale para o docker-compose e para `dotnet run`.
HANGFIRE_DESABILITADO=false

# ------------------------------------------------------------------------------
# OCI Object Storage — Armazenamento de documentos (Módulo 13)
# Guia: Identity → Users → <usuário> → Customer Secret Keys
# ------------------------------------------------------------------------------
OCI_NAMESPACE=seu_namespace_oci
OCI_REGION=sa-saopaulo-1
OCI_BUCKET_NAME=legal-manager-docs
OCI_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
OCI_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Stripe — Assinaturas e pagamentos (cartão + Pix) (Módulo 5)
# https://dashboard.stripe.com/test/apikeys — use as chaves de teste (sk_test_...) em dev
# https://dashboard.stripe.com/test/webhooks — crie um endpoint apontando para
#   {APP_FRONTEND_URL}/api/webhooks/stripe e copie o "Signing secret" (whsec_...)
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# IA / LLM — Integrações com IA (Módulo 10)
# Provedor: Anthropic (Claude) ou OpenAI
# ------------------------------------------------------------------------------
# Provedor da IA: "Anthropic" | "OpenAI"
IA_PROVIDER=Anthropic
# Chave da API do provedor selecionado
IA_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a ser utilizado
# Anthropic: claude-3-5-sonnet-latest | claude-3-haiku-latest
# OpenAI:   gpt-4o | gpt-4o-mini | gpt-4-turbo
IA_MODEL=claude-3-5-sonnet-latest
# Tempo máximo, em segundos, de cada operação de IA, incluindo a reescrita de idioma (padrão: 90;
# fique abaixo dos 100 s do Cloudflare)
IA_TIMEOUT_SECONDS=90
# Mesmo limite para operações em background, como o resumo do processo (padrão: 240)
IA_TIMEOUT_BACKGROUND_SECONDS=240
# URL base da API (opcional — útil para proxies ou ambientes on-premise)
# ex.: IA_BASE_URL=https://api.anthropic.com/v1
IA_BASE_URL=
# Profundidade de raciocínio (opcional, só provedor OpenAI/compatíveis): low | medium | high | xhigh | max.
# Vazio = padrão do modelo. Ex.: MiniMax-M3.1-Flash (padrão max); MiniMax-M3 ignora.
# ex.: IA_REASONING_EFFORT=medium
IA_REASONING_EFFORT=

# Assistente de IA (perguntas sobre os dados do escritório) — opcional.
# Sem ASSISTENTE_PROVIDER, usa a mesma configuração IA_* acima. O modelo precisa suportar
# chamada de ferramentas (tool use / function calling).
# ex.: ASSISTENTE_PROVIDER=Anthropic
ASSISTENTE_PROVIDER=
# ex.: ASSISTENTE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASSISTENTE_API_KEY=
# ex.: ASSISTENTE_MODEL=claude-sonnet-5-5
ASSISTENTE_MODEL=
ASSISTENTE_BASE_URL=
# ex.: ASSISTENTE_REASONING_EFFORT=medium
ASSISTENTE_REASONING_EFFORT=

# ------------------------------------------------------------------------------
# DataJud — API Pública do CNJ (https://www.cnj.jus.br/sistemas/datajud/api-publica/)
# ------------------------------------------------------------------------------
DATAJUD_API_KEY=
# URL base (opcional — padrão: https://api-publica.datajud.cnj.jus.br)
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ------------------------------------------------------------------------------
# Escavador — Processos Federais (TRF) e Trabalhistas (TRT)
# Obtenha o token em: https://www.escavador.com/sobre/api
# CallbackSecret: string aleatória para validar webhooks recebidos do Escavador
#   Gere com: openssl rand -base64 32
# CallbackUrl: configure esta URL no dashboard do Escavador em
#   https://api.escavador.com/callbacks → aponta para /api/escavador/callback
# ------------------------------------------------------------------------------
ESCAVADOR_API_TOKEN=
ESCAVADOR_CALLBACK_SECRET=
# true = usa o mock do WireMock em vez da API real (suba com `docker compose --profile mock up -d`
# e aponte ESCAVADOR_BASE_URL para http://escavador-mock:8080). Estas duas valem só para o
# docker-compose; no `dotnet run` use Escavador__UseMock=true e Escavador__BaseUrl=http://localhost:8888.
ESCAVADOR_USE_MOCK=false
ESCAVADOR_BASE_URL=https://api.escavador.com

# ------------------------------------------------------------------------------
# Super Admin — Painel interno de gestão da plataforma (/superadmin/)
# O usuário é criado automaticamente na primeira execução.
# Gere uma senha forte: openssl rand -base64 24
# ------------------------------------------------------------------------------
SUPERADMIN_EMAIL=superadmin@causify.internal
SUPERADMIN_PASSWORD=troque_esta_senha_forte
