# URL base da API (padrão: http://localhost:5123)
BASE_URL=http://localhost:6600

# Credenciais de um usuário administrador para testes
TEST_ADMIN_EMAIL=seu@email.com
TEST_ADMIN_PASSWORD=SuaSenhaAdmin

# Credenciais de um cliente cadastrado para testes do portal
TEST_CLIENT_EMAIL=cliente@email.com
TEST_CLIENT_PASSWORD=SenhaDoCliente

# Credenciais do super admin (perfil = SuperAdmin) para testes do painel super admin
TEST_SUPERADMIN_EMAIL=superadmin@causify.internal
TEST_SUPERADMIN_PASSWORD=SenhaDoSuperAdmin

# IDs de tenants para o teste de export/import em tests/flows/tenant-export-import.spec.ts
# (precisa de 2 tenants reais cadastrados; copie os IDs da página /superadmin/tenants.html)
TEST_SUPERADMIN_TENANT_ORIGEM=
TEST_SUPERADMIN_TENANT_DESTINO=
